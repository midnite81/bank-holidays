{
    "name": "midnite81/bank-holidays",
    "description": "A library to get UK bank holidays",
    "type": "library",
    "require": {
        "php": "^8.2",
        "nesbot/carbon": "^2.72|^3.0",
        "php-http/curl-client": "^1.0|^2.1",
        "guzzlehttp/psr7": "^1.6|^2.0",
        "php-http/message": "^1.0",
        "http-interop/http-factory-guzzle": "^1.0",
        "midnite81/json-parser": "^1.0"
    },
    "require-dev": {
        "laravel/framework": "^10.0|^11.0|^12.0",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "phpunit/phpunit": "^10.0|^11.0",
        "mockery/mockery": "^1.1",
        "symfony/finder": "^6.0|^7.0",
        "php-coveralls/php-coveralls": "^2.7",
        "orchestra/testbench": "^8.0|^9.0|^10.0"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Simon Rogers",
            "email": "webdev@centralblue.co.uk"
        }
    ],
      "autoload": {
              "psr-4": {
                  "Midnite81\\BankHolidays\\": "src/",
                  "Midnite81\\BankHolidays\\Tests\\": "tests/"
              }
          },
          "autoload-dev": {
              "psr-4": {
                  "Midnite81\\\\Tests\\": "tests/"
              }
          },
    "minimum-stability": "stable",
    "extra": {
        "component": "package",
        "frameworks": [
            "Laravel 10",
            "Laravel 11",
            "Laravel 12"
        ],
        "laravel": {
            "providers": [
                "Midnite81\\BankHolidays\\BankHolidayServiceProvider"
            ]
        }
    }
}
